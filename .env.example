# Deployment environment name (e.g. "development", "staging", "production").
ENVIRONMENT=development

# Comma-separated list of origins allowed to make CORS requests to the API.
CORS_ORIGINS=http://localhost:5173

# Directory where downloaded/cached ML models are stored on disk.
MODEL_CACHE_DIR=./models_cache

# Maximum length, in pixels, of an uploaded image's longest side before resizing.
MAX_IMAGE_SIDE=1600

# Minimum log level for application logging (e.g. DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# When true, disables any network calls (e.g. model downloads) and uses local/cached resources only.
OFFLINE_MODE=false
